{
  "manifest_version": 3,
  "name": "Microleitura",
  "version": "0.4.1",
  "description": "Microleitura em páginas web e no ChatGPT: Lido, Entendido, Revisar e Importante/Dúvida.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_title": "Microleitura"}
}
